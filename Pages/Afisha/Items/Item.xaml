<UserControl x:Class="Kino_Bartova.Pages.Afisha.Items.Item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Kino_Bartova.Pages.Afisha.Items"
             mc:Ignorable="d">
    <Grid Margin="20" Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100px"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Width="80" HorizontalAlignment="Center" Margin="0,10,0,0" Source="C:\Users\ADMIN\Desktop\Kino_Bartova\Kino_Bartova\Images\ic-afisha.png" Height="80" VerticalAlignment="Top"/>
        <Label Content="Кинотеатр:" Grid.Column="1" Margin="10,10,10,0" Height="26" VerticalAlignment="Top"/>
        <TextBox x:Name="kinoteatrs" Grid.Column="1" Margin="10,36,10,0" IsEnabled="False" Height="25" VerticalAlignment="Top"/>
        <Label Content="Наименование:" Grid.Column="1" Margin="10,66,10,0" Height="26" VerticalAlignment="Top"/>
        <TextBox x:Name="name" Grid.Column="1" Margin="10,92,10,0" IsEnabled="False" Height="25" VerticalAlignment="Top"/>
        <Label Content="Дата:" Grid.Column="2" Margin="10,10,10,0" Height="26" VerticalAlignment="Top"/>
        <DatePicker x:Name="date" Grid.Column="2" Margin="10,36,0,0" HorizontalAlignment="Left" Width="200" Height="25" VerticalAlignment="Top"/>
        <Label Content="Стоимость:" Grid.Column="2" Margin="10,66,10,0" Height="26" VerticalAlignment="Top"/>
        <TextBox x:Name="price" Grid.Column="2" Margin="10,92,10,0" IsEnabled="False" Height="25" VerticalAlignment="Top"/>
        <TextBox x:Name="time" Grid.Column="2" Margin="220,36,10,0" Height="18" VerticalAlignment="Top"/>
        <Button Click="EditRecord" Content="Изменить" Margin="5,97,0,0" HorizontalAlignment="Left" Width="80" Background="#FF73E618" BorderBrush="#FF73E618" Foreground="White" Height="25" VerticalAlignment="Top"/>
        <Button Click="DeleteRecord" Content="Удалить" Margin="5,127,0,0" HorizontalAlignment="Left" Width="80" Background="Red" BorderBrush="#FF73E618" Foreground="White" Height="25" VerticalAlignment="Top"/>
    </Grid>
</UserControl>
