<UserControl x:Class="Kino_Bartova.Pages.Kinoteatr.Items.Item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Kino_Bartova.Pages.Kinoteatr.Items"
             mc:Ignorable="d">
    <Grid Margin="10" Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100px"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Width="80" Height="80" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10" Source="C:\Users\ADMIN\Desktop\Kino_Bartova\Kino_Bartova\Images\ic-kino.png"/>
        <Label Content="Наименование:" Grid.Column="1" VerticalAlignment="Top" Margin="10"/>
        <TextBox x:Name="name" Height="25" Grid.Column="1" Margin="10,36,10,0" IsEnabled="False" VerticalAlignment="Top"/>
        <Label Content="Количество залов:" Grid.Column="1" VerticalAlignment="Top" Margin="10,66,10,0"/>
        <TextBox x:Name="countZal" Height="25" Grid.Column="1" Margin="10,92,10,0" IsEnabled="False" VerticalAlignment="Top"/>
        <Label Content="Количество:" Grid.Column="2" VerticalAlignment="Top" Margin="10,10,10,0"/>
        <TextBox x:Name="count" Height="25" Grid.Column="2" Margin="10,46,10,0" IsEnabled="False" VerticalAlignment="Top"/>
        <Button Click="EditRecord" Content="Изменить" Height="25" Margin="5,97,0,0" HorizontalAlignment="Left" Width="80" Background="#FF73E618" BorderBrush="#FF73E618" Foreground="White" VerticalAlignment="Top"/>
        <Button Click="DeletRecord" Content="Удалить" Height="25" Margin="5,127,0,0" HorizontalAlignment="Left" Width="80" Background="Red" BorderBrush="#FF73E618" Foreground="White" VerticalAlignment="Top"/>
    </Grid>

</UserControl>
